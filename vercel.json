{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "regions": ["cdg1"],
  "crons": [
    { "path": "/api/agenda/rappels", "schedule": "0 16 * * *" },
    { "path": "/api/compte/inactivite", "schedule": "0 9 * * *" },
    { "path": "/api/avis/demandes", "schedule": "0 17 * * *" }
  ]
}
