# Style MapLibre (URL d'un style JSON). Vide = fond clair CARTO Positron (raster, gratuit, attribution incluse).
NEXT_PUBLIC_MAP_STYLE_URL=
# Dossier de stockage local des images uploadées (implémentation disque de lib/storage).
UPLOAD_DIR=.data/uploads
# URL publique du site (sitemap, robots, aperçus de liens), sans / final.
# Défaut : le domaine de production Vercel (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Alerte e-mail à chaque inscription tatoueur (Resend, facultatif)
RESEND_API_KEY=
SIGNUP_NOTIFY_EMAIL=

# Paiement des tatoueurs (Stripe Checkout). Sans clé : pas d'encaissement
# (inscription enregistrée sans paiement ; mode démo dans l'espace pro).
STRIPE_SECRET_KEY=
# Optionnel : identifiants de prix Stripe price_… (ou de produit prod_…), sinon prix créés à la volée depuis lib/pro-offer.ts.
# État de la configuration : page /admin → « Paiement en ligne ».
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Webhook Stripe (URL : https://<ton-site>/api/billing/webhook) : secret de signature « whsec_… ».
# Tient à jour l'abonnement dans Neon (fin d'essai, renouvellement, échec de paiement, résiliation).
STRIPE_WEBHOOK_SECRET=

# Page /admin (validation des profils tatoueurs) : mot de passe d'accès, 8 caractères minimum.
ADMIN_PASSWORD=
